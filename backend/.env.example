# Backend environment example
DATABASE_URL=postgres://postgres:password@localhost:5432/equiptrack
PORT=5000
JWT_SECRET=your_jwt_secret_here
MQTT_HOST=localhost
MQTT_PORT=1883
# Optional — must match iot_system device_serial_number (package_001, …)
MQTT_TOPIC_PATTERN=ericsson/sites/+/+/gps
AI_SERVICE_URL=http://localhost:8000
# Set to false to accept photos when AI is down (dev only). Default: strict reject.
AI_SERVICE_STRICT=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
