# Local dev (Mosquitto from backend/docker-compose.yml)
BROKER_HOST=localhost
BROKER_PORT=1883
MQTT_USE_TLS=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Publish interval (seconds) — match backend polling
GPS_INTERVAL=10

# HiveMQ Cloud (production / remote broker)
# BROKER_HOST=your-broker.hivemq.cloud
# BROKER_PORT=8883
# MQTT_USE_TLS=true
# MQTT_USERNAME=your_user
# MQTT_PASSWORD=your_password
