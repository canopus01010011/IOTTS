# MQTT broker (must match backend MQTT_HOST / MQTT_PORT)
BROKER_HOST=broker.hivemq.com
BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Routes only by default. Enable live GPS simulation later:
# IOT_RUN_SIMULATOR=true

# GPS publish interval (seconds)
GPS_INTERVAL=5

# Optional: POST GPS to backend instead of/in addition to MQTT
# BACKEND_URL=https://perceptive-energy-production-a390.up.railway.app/api/gps/iot
# IOT_API_TOKEN=your_token_if_set_on_backend
